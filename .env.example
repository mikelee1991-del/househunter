# Optional — enables live multi-source daily ingest (npm run ingest)
# Free tier: https://developers.rentcast.io/ (50 req/mo) — or use npm run ingest:market
RENTCAST_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_REALTOR_HOST=realtor16.p.rapidapi.com

# Optional overrides for IDX market scrape (npm run ingest:market)
# INGEST_MIN_PRICE=1000000
# INGEST_MAX_PRICE=12000000

# Optional — OpenRouteService as an alternate to default Valhalla isochrones
# https://openrouteservice.org/dev/#/signup
# Default (no key): Valhalla at valhalla1.openstreetmap.de — same as SimpleMapLab.
VITE_ORS_API_KEY=
