{
  "name": "househunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest-listings.ts",
    "ingest:market": "node scripts/scrape-mbconfidential.mjs",
    "ingest:enrich": "node scripts/enrich-mbc-listings.mjs",
    "ingest:regeocode": "node scripts/regeocode-listings.mjs",
    "ingest:refresh": "node scripts/refresh-mbc-market.mjs",
    "ingest:verify": "node scripts/verify-listings-sereno.mjs",
    "ingest:sereno": "node scripts/scrape-sereno-areas.mjs",
    "ingest:redfin": "node scripts/scrape-redfin-market.mjs",
    "ingest:all": "node scripts/ingest-all.mjs",
    "ingest:precompute": "tsx scripts/precompute-listing-scores.ts",
    "build:safety": "node scripts/build-safety-tracts.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright": "^1.54.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
